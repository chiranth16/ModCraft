{
  "schemaVersion": 1,
  "id": "resourceroulette",
  "version": "${version}",
  "name": "resourceRoulette",
  "description": "",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value":"org.chiranth.resourceroulette.client.ResourcerouletteDataGenerator"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value":"org.chiranth.resourceroulette.client.ResourcerouletteClient"
      }
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value":"org.chiranth.resourceroulette.ResourceRoulette"
      }
    ]
  },
  "mixins": [
    "resourceroulette.mixins.json",
    {
      "config": "resourceroulette.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
